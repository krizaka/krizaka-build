<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent of every Krizaka JVM artifact.

         It carries what Maven Central requires of a published POM (name, description, url,
         licence, developers, scm) and the build conventions every Krizaka repository shares:
         Java 21, google-java-format checked at `validate`, unit and integration tests, coverage,
         and an enforced toolchain. The `release` profile adds the sources and javadoc jars, the
         signature and the upload to the Central Portal.

         Deliberately NO <dependencyManagement>: krizaka-bom inherits this POM, and a BOM carries
         its parent's managed dependencies into every project that imports it. A consumer importing
         krizaka-bom must get the Krizaka artifacts and nothing else — never a Spring version it
         did not ask for. Each repository imports the Spring Boot BOM itself. -->
    <groupId>com.krizaka</groupId>
    <artifactId>krizaka-parent</artifactId>
    <version>0.3.3</version>
    <packaging>pom</packaging>

    <name>Krizaka Parent</name>
    <description>Parent POM of every Krizaka JVM artifact: Maven Central metadata, Java 21 build conventions (formatting, tests, coverage, enforcer) and the signed release to Maven Central.</description>
    <url>https://github.com/krizaka/krizaka-build</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>Krizaka</name>
        <url>https://krizaka.com</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>krizaka</id>
            <name>The Krizaka team</name>
            <organization>Krizaka</organization>
            <organizationUrl>https://krizaka.com</organizationUrl>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <url>https://github.com/krizaka/krizaka-build</url>
        <connection>scm:git:https://github.com/krizaka/krizaka-build.git</connection>
        <developerConnection>scm:git:git@github.com:krizaka/krizaka-build.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/krizaka/krizaka-build/issues</url>
    </issueManagement>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Reproducible builds: a fixed timestamp makes two builds of one commit byte-identical. -->
        <project.build.outputTimestamp>2026-10-08T00:00:00Z</project.build.outputTimestamp>

        <!-- The Spring Boot line the Krizaka artifacts are built and tested against. Each
             repository imports its BOM; the version lives here so they move together. -->
        <spring-boot.version>4.0.9</spring-boot.version>

        <!-- Plugin versions -->
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <jacoco.version>0.8.15</jacoco.version>
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
        <google-java-format.version>1.22.0</google-java-format.version>
        <japicmp-maven-plugin.version>0.26.5</japicmp-maven-plugin.version>
        <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
        <rewrite-maven-plugin.version>6.46.1</rewrite-maven-plugin.version>
        <rewrite-static-analysis.version>2.41.1</rewrite-static-analysis.version>
        <rewrite-testing-frameworks.version>3.44.0</rewrite-testing-frameworks.version>
        <rewrite-migrate-java.version>3.42.1</rewrite-migrate-java.version>
        <rewrite-spring.version>6.37.1</rewrite-spring.version>
        <!-- The released version of krizaka-rewrite-style (this repository): written out, because ${project.version}
             would be the version of the project that inherits this POM. release-please moves it with the release. -->
        <krizaka-rewrite-style.version>0.3.3</krizaka-rewrite-style.version> <!-- x-release-please-version -->
        <!-- Likewise krizaka-quality (the PMD and SpotBugs rules, ADR-013). -->
        <krizaka-quality.version>0.3.3</krizaka-quality.version> <!-- x-release-please-version -->
        <!-- Phase of the PMD and SpotBugs checks (none = off), and each module's measured baselines. -->
        <krizaka.quality.phase>verify</krizaka.quality.phase>
        <krizaka.pmd.baseline>${project.basedir}/pmd-baseline.properties</krizaka.pmd.baseline>
        <krizaka.spotbugs.exclude>${project.basedir}/spotbugs-exclude.xml</krizaka.spotbugs.exclude>
        <krizaka.spotbugs.failOnError>true</krizaka.spotbugs.failOnError>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <spotbugs-maven-plugin.version>4.10.5.0</spotbugs-maven-plugin.version>
        <findsecbugs-plugin.version>1.14.0</findsecbugs-plugin.version>

        <!-- ADR-015: JSpecify (@NullMarked, managed in krizaka-bom) and NullAway, hosted by Error Prone. -->
        <jspecify.version>1.0.1</jspecify.version>
        <errorprone.version>2.51.0</errorprone.version>
        <nullaway.version>0.14.3</nullaway.version>

        <!-- Release behaviour (Central Portal). With autoPublish=false the deployment is uploaded
             and validated, then waits in the portal for a human to press "Publish": a release on
             Central can never be deleted, so the first ones are checked by eye. -->
        <central.autoPublish>false</central.autoPublish>
        <central.waitUntil>validated</central.waitUntil>

        <!-- Binary compatibility (japicmp, release profile): every jar is compared with its latest
             release on Maven Central, and a binary-incompatible change fails the build. A deliberate
             break — a major version, or a minor before 1.0 (release-please bump-minor-pre-major) —
             sets japicmp.breakBuildOnBinaryIncompatibleModifications=false in that repository for
             that release; japicmp.skip turns the comparison off entirely. -->
        <japicmp.skip>false</japicmp.skip>
        <japicmp.breakBuildOnBinaryIncompatibleModifications>true</japicmp.breakBuildOnBinaryIncompatibleModifications>

        <!-- The surefire/failsafe argLine is completed by JaCoCo's prepare-agent; this default
             keeps it valid when JaCoCo is skipped. -->
        <argLine/>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Lifecycle plugins pinned: enforcer's requirePluginVersions refuses a build that
                     would otherwise change with the Maven version that runs it. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <!-- Mockito 5 attaches its agent dynamically; JDK 21 asks for consent. -->
                        <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine} -XX:+EnableDynamicAgentLoading</argLine>
                        <!-- A Spring Boot module's `package` replaces the jar with the repackaged
                             one; the integration tests read the classes directory instead. -->
                        <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <version>${google-java-format.version}</version>
                                <style>GOOGLE</style>
                            </googleJavaFormat>
                        </java>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>${maven-gpg-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>${central-publishing-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.siom79.japicmp</groupId>
                    <artifactId>japicmp-maven-plugin</artifactId>
                    <version>${japicmp-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- The toolchain every Krizaka build assumes, checked before anything else runs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <banDuplicatePomDependencyVersions/>
                                <requirePluginVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ADR-013, krizaka-build#105: the local twin of the Sonar Java findings, in `verify` (so `mvn verify` catches
                 them before the push). Rules: krizaka-quality. A NEW violation fails; the existing ones of a module are
                 frozen in its own pmd-baseline.properties and spotbugs-exclude.xml, measured by scripts/quality-baseline.mjs,
                 which only lets them shrink.

                 `-Dkrizaka.quality.phase=none` switches both off: krizaka-build itself does (its .mvn/maven.config), because
                 its parent POM would have to resolve the rules before they are built. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <configuration>
                    <rulesets>
                        <ruleset>krizaka-quality/pmd-ruleset.xml</ruleset>
                    </rulesets>
                    <includeTests>false</includeTests>
                    <linkXRef>false</linkXRef>
                    <printFailingErrors>true</printFailingErrors>
                    <failurePriority>5</failurePriority>
                    <excludeFromFailureFile>${krizaka.pmd.baseline}</excludeFromFailureFile>
                </configuration>
                <executions>
                    <execution>
                        <id>krizaka-pmd</id>
                        <phase>${krizaka.quality.phase}</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.krizaka</groupId>
                        <artifactId>krizaka-quality</artifactId>
                        <version>${krizaka-quality.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Default</effort>
                    <threshold>Medium</threshold>
                    <failOnError>${krizaka.spotbugs.failOnError}</failOnError>
                    <includeFilterFile>krizaka-quality/spotbugs-include.xml</includeFilterFile>
                    <excludeFilterFile>${krizaka.spotbugs.exclude}</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>krizaka-spotbugs</id>
                        <phase>${krizaka.quality.phase}</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.krizaka</groupId>
                        <artifactId>krizaka-quality</artifactId>
                        <version>${krizaka-quality.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Formatting is checked at `validate`, the first phase: a badly formatted file fails
                 the build before anything compiles, and -DskipTests cannot route around it.
                 `./mvnw spotless:apply` fixes it. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- *IT classes run in `integration-test`, and `verify` fails the build on them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- OpenRewrite — the codemods and the "no debt" check of every Krizaka JVM repository.
                 `./mvnw rewrite:dryRun` lists what the recipes would change and FAILS when there is anything
                 (the organisation pipeline, krizaka/.github maven.yml, runs it); `./mvnw rewrite:run`
                 applies it — behaviour identical, run the tests after, land it in a small pull request.
                 Recipes: common static analysis, test cleanup (RemoveTestPrefix — NOT TestsShouldIncludeAssertions, which wraps
                 a test body in assertDoesNotThrow and turns an aborted assumption into a failure), Java 21 idioms, Spring
                 idioms (no @Autowired on a constructor; @Bean methods stay public — the platform kit's auto-configurations are published API, japicmp guards them), duplicate POM dependencies. A recipe
                 that is wrong for one repository is excluded in THAT repository (<exclusions>), never here. -->
            <plugin>
                <groupId>org.openrewrite.maven</groupId>
                <artifactId>rewrite-maven-plugin</artifactId>
                <version>${rewrite-maven-plugin.version}</version>
                <configuration>
                    <failOnDryRunResults>true</failOnDryRunResults>
                    <activeRecipes>
                        <recipe>org.openrewrite.staticanalysis.CommonStaticAnalysis</recipe>
                        <recipe>org.openrewrite.java.testing.cleanup.RemoveTestPrefix</recipe>
                        <recipe>org.openrewrite.java.migrate.UpgradeToJava21</recipe>
                        <recipe>org.openrewrite.java.spring.NoAutowiredOnConstructor</recipe>
                        <recipe>org.openrewrite.maven.RemoveDuplicateDependencies</recipe>
                    </activeRecipes>
                    <!-- The Java style is explicit (krizaka-rewrite-style: no star import, static imports first), never
                         autodetected: one `import java.util.*;` once folded the imports of 29 untouched files. -->
                    <activeStyles>
                        <style>com.krizaka.rewrite.KrizakaJavaStyle</style>
                    </activeStyles>
                    <!-- Test fixtures break rules on purpose (the rules' own tests need a defect to find). -->
                    <exclusions>
                        <exclusion>**/fixture/**</exclusion>
                    </exclusions>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>com.krizaka</groupId>
                        <artifactId>krizaka-rewrite-style</artifactId>
                        <version>${krizaka-rewrite-style.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-static-analysis</artifactId>
                        <version>${rewrite-static-analysis.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-testing-frameworks</artifactId>
                        <version>${rewrite-testing-frameworks.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-migrate-java</artifactId>
                        <version>${rewrite-migrate-java.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.openrewrite.recipe</groupId>
                        <artifactId>rewrite-spring</artifactId>
                        <version>${rewrite-spring.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `./mvnw -Prelease deploy` — what Maven Central requires of every artifact.

             - sources and javadoc jars (the javadoc build also proves the documentation compiles);
             - a detached OpenPGP signature on every file, made by the Bouncy Castle signer: no
               gpg binary is needed, the key comes from MAVEN_GPG_KEY (ASCII-armoured private key)
               and MAVEN_GPG_PASSPHRASE;
             The registry is configuration (ADR-019, krizaka/.github): `release` alone is registry-neutral and
             deploys wherever -DaltDeploymentRepository points (GitHub Packages:
             `-DaltDeploymentRepository=github::https://maven.pkg.github.com/krizaka/<repository>`, token in the
             `github` server of settings.xml). Add `-Pregistry-central` to upload to the Central Portal instead
             (server id `central`, a Portal user token in settings.xml or MAVEN_CENTRAL_USERNAME / _PASSWORD).

             `-Dgpg.skip` runs the whole profile without a key: CI does that on every pull request,
             so a javadoc error is found the day it is written, not on release day. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <release>${java.version}</release>
                            <doclint>all,-missing</doclint>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <links>
                                <link>https://docs.spring.io/spring-framework/docs/current/javadoc-api/</link>
                            </links>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <signer>bc</signer>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- SemVer is checked, not promised: the jar is compared with the latest release
                         of the same artifact on Maven Central (releasedVersion.version, resolved by
                         build-helper; none yet — a new artifact — passes). -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>latest-release</id>
                                <goals>
                                    <goal>released-version</goal>
                                </goals>
                            </execution>
                            <!-- An artifact never released leaves releasedVersion.version unset:
                                 compare with 0.0.0, which does not exist, and ignoreMissingOldVersion
                                 lets the first release through. -->
                            <execution>
                                <id>japicmp-old-version-or-none</id>
                                <goals>
                                    <goal>regex-property</goal>
                                </goals>
                                <configuration>
                                    <name>japicmp.prefixedOldVersion</name>
                                    <value>v${releasedVersion.version}</value>
                                    <regex>^v\$\{.*\}$</regex>
                                    <replacement>v0.0.0</replacement>
                                    <failIfNoMatch>false</failIfNoMatch>
                                </configuration>
                            </execution>
                            <execution>
                                <id>japicmp-old-version</id>
                                <goals>
                                    <goal>regex-property</goal>
                                </goals>
                                <configuration>
                                    <name>japicmp.oldVersion</name>
                                    <value>${japicmp.prefixedOldVersion}</value>
                                    <regex>^v</regex>
                                    <replacement/>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.siom79.japicmp</groupId>
                        <artifactId>japicmp-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>binary-compatibility</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>cmp</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <skip>${japicmp.skip}</skip>
                            <oldVersion>
                                <dependency>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>${japicmp.oldVersion}</version>
                                    <type>${project.packaging}</type>
                                </dependency>
                            </oldVersion>
                            <parameter>
                                <breakBuildOnBinaryIncompatibleModifications>${japicmp.breakBuildOnBinaryIncompatibleModifications}</breakBuildOnBinaryIncompatibleModifications>
                                <onlyBinaryIncompatible>true</onlyBinaryIncompatible>
                                <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                                <skipPomModules>true</skipPomModules>
                                <skipXmlReport>true</skipXmlReport>
                                <skipHtmlReport>true</skipHtmlReport>
                            </parameter>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- `./mvnw -Prelease,registry-central deploy` — the Central Portal upload (extension plugin: it takes over the
             deploy phase). Not part of `release`, so a GitHub Packages deployment never goes near Central. -->
        <profile>
            <id>registry-central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>${central.waitUntil}</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
            <!-- A module without a spotbugs-exclude.xml has no baseline: it is strict (nothing frozen), not a build error
             ("Could not find resource"). Adopting a module = running scripts/quality-baseline.mjs init. -->
        <profile>
            <id>krizaka-spotbugs-no-baseline</id>
            <activation>
                <file>
                    <missing>${basedir}/spotbugs-exclude.xml</missing>
                </file>
            </activation>
            <properties>
                <krizaka.spotbugs.exclude>krizaka-quality/spotbugs-exclude-empty.xml</krizaka.spotbugs.exclude>
            </properties>
        </profile>

        <!-- ADR-015, krizaka-build#120: NullAway checks every package marked @NullMarked (JSpecify), and only those
             (OnlyNullMarked): marking a package is the ratchet, there is no flag day. Error Prone is only NullAway's
             host (-XepDisableAllChecks). ON by default; one property turns it off: -Dkrizaka.nullaway.skip=true.
             Error Prone runs inside javac, which needs the jdk.compiler packages opened, hence the forked compiler. -->
        <profile>
            <id>krizaka-nullaway</id>
            <activation>
                <property>
                    <name>!krizaka.nullaway.skip</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <fork>true</fork>
                            <compilerArgs combine.children="append">
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>${nullaway.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
</profiles>
</project>
