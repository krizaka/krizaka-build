<?xml version="1.0" encoding="UTF-8"?>
<!-- The Krizaka SpotBugs filter (ADR-013, krizaka-build#105): what is reported at all, before the per-module
     spotbugs-exclude.xml baseline freezes the existing findings. Needs the find-sec-bugs plugin. -->
<FindBugsFilter>
    <Match>
        <Or>
            <!-- S2077 SQL built from strings -->
            <Bug pattern="SQL_INJECTION_JDBC,SQL_INJECTION_SPRING_JDBC,SQL_INJECTION_JPA,SQL_INJECTION_HIBERNATE,SQL_INJECTION_JDO,SQL_INJECTION_ANDROID,SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE,SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
            <!-- S5998 regular expression open to catastrophic backtracking -->
            <Bug pattern="REDOS"/>
            <!-- S2789 / S2259 style bugs the Sonar bug rules catch: real SpotBugs correctness defects -->
            <Bug category="CORRECTNESS"/>
        </Or>
    </Match>
</FindBugsFilter>
