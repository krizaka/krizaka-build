<?xml version="1.0" encoding="UTF-8"?>
<!-- Canary consumer (krizaka-build#105): a module that inherits krizaka-parent and has NO pmd-baseline.properties
     nor spotbugs-exclude.xml, verified with the quality checks ON. CI builds it after installing the quality rules
     and the parent, so a parent change that breaks consumers fails here, before the merge. Never published. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.krizaka</groupId>
        <artifactId>krizaka-parent</artifactId>
        <version>0.3.1</version>
        <relativePath>../krizaka-parent/pom.xml</relativePath>
    </parent>
    <artifactId>krizaka-canary</artifactId>
    <name>Krizaka Canary</name>
    <description>Consumer of krizaka-parent without baselines, verified with PMD, SpotBugs and NullAway on.</description>

    <dependencies>
        <!-- @NullMarked: the canary's package is checked by NullAway (ADR-015, krizaka-build#120). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
        </dependency>
    </dependencies>

    <profiles>
        <!-- A class that breaks the NullAway contract. CI compiles it and EXPECTS the build to fail: the profile proves
             the rule bites (a rule that cannot fail proves nothing). Never part of the default build. -->
        <profile>
            <id>canary-violation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-violation</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/violation/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
