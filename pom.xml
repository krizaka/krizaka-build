<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Reactor of krizaka-build: the parent POM, the BOM and the test kit. -->
    <parent>
        <groupId>com.krizaka</groupId>
        <artifactId>krizaka-parent</artifactId>
        <version>0.8.1</version>
        <relativePath>krizaka-parent/pom.xml</relativePath>
    </parent>

    <artifactId>krizaka-build</artifactId>
    <packaging>pom</packaging>
    <name>Krizaka Build</name>
    <description>Build foundation of the Krizaka JVM artifacts: parent POM, BOM, test kit, the platform kit, the users service and the billing service.</description>

    <properties>
        <!-- The reactor itself is not an artifact anyone depends on. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- The Maven scanner (job "maven / SonarCloud") does not read sonar-project.properties, so the ignore lives here too.
             The SQL is PostgreSQL (initdb scripts), not Oracle PL/SQL: plsql:CharVarchar (use VARCHAR2) does not apply,
             CHAR(3) is the ISO 4217 currency code. -->
        <sonar.issue.ignore.multicriteria>postgresSql</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.postgresSql.ruleKey>plsql:CharVarchar</sonar.issue.ignore.multicriteria.postgresSql.ruleKey>
        <sonar.issue.ignore.multicriteria.postgresSql.resourceKey>**/*.sql</sonar.issue.ignore.multicriteria.postgresSql.resourceKey>
    </properties>

    <modules>
        <!-- First on purpose: the parent's plugins depend on it. Maven reads that edge as a cycle with the parent
             relation only when the parent is declared before it. -->
        <module>krizaka-quality</module>
        <module>krizaka-parent</module>
        <module>krizaka-bom</module>
        <module>krizaka-rewrite-style</module>
        <module>krizaka-test-support</module>
        <module>krizaka-payments</module>
        <module>krizaka-platform-kit</module>
        <module>krizaka-users</module>
        <module>krizaka-billing</module>
    </modules>
</project>
