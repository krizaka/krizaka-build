    <artifactId>krizaka-bom</artifactId>
    <packaging>pom</packaging>
    <name>Krizaka BOM</name>
    <description>Bill of materials of the Krizaka JVM artifacts: import it once and every com.krizaka dependency resolves to one coherent release.</description>

    <!-- Every published com.krizaka artifact, plus JSpecify (below): importing this BOM never changes the
         version of a third-party library Spring Boot manages (see krizaka-parent).

         Each repository is versioned on its own (SemVer, release-please); the BOM is what makes a
         set compatible: one property per repository names the release this BOM was tested with.
         Each names the release of that repository that is in the Orazaka workspace (every repository is
         cloned at main and built from source there), so a version here that the repository's main does
         not carry cannot resolve: the workspace guard (scripts/check-krizaka-versions.mjs) fails on it.
         A release of krizaka-build sets each one to the version of that repository it ships with. -->
    <properties>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- The one third-party entry (ADR-015, krizaka-build#120): the nullness annotations every module of the
                 NullAway profile of krizaka-parent marks its packages with. Same version as Spring Boot's own. -->
            <dependency>
                <groupId>org.jspecify</groupId>
                <artifactId>jspecify</artifactId>
                <version>${jspecify.version}</version>
            </dependency>

